# Python、测试和 Notebook 缓存
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# 本地环境与编辑器状态
.env
.venv/
/.conda_envs/
.vscode/
.idea/

# 运行日志和派生结果（均可由输入与配置重建）
/logs/
/results/
/runs/
**/output/
**/expost/
**/plots/
*.log
*.log~1

# 正式案例的原始数据和临时工作区
# 小型可分发样例必须放在 tests/fixtures/，不得放入这些目录。
/IN_DATA/
/cases/**/raw/
/cases/**/work/
/cases/**/generated/

# tests/fixtures/ 下的 CSV、GeoJSON、XLSX 和 Parquet 不按扩展名忽略，
# 以便将合成输入、数据字典和校验基准纳入版本管理。
!tests/fixtures/**
!cases/**/README.md

# New package/build artifacts; no source or synthetic fixture exclusion.
/build/
/dist/
*.egg-info/
/work/
